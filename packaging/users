# rusty-sock users: one `username:argon2id-hash` entry per line.
#
# Create a hash (reads the password from stdin):
#   printf '%s\n' 'the-password' | rusty-sock hash-password
# and append it, e.g.:
#   echo "alice:$(printf '%s\n' 'the-password' | rusty-sock hash-password)" >> /etc/rusty-sock/users
#
# Keep this file root-owned with mode 0600; the service reads it through
# systemd's LoadCredential. Restart the service after editing.
